{
  "name": "throwdown-rps",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n arena,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.180.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/three": "^0.180.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
