{
  "name": "throwdown-rps",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n arena,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "check:worker": "tsc -p tsconfig.worker.json && wrangler deploy --dry-run",
    "dev:worker": "wrangler dev --port 8787",
    "test:worker:live": "node tests/cloud-worker-live.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "express": "^5.2.1",
    "qrcode-generator": "^2.0.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.180.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/three": "^0.180.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "wrangler": "^4.141.0"
  }
}
